     "ropa_o_material":{"capas":[{"orden":1,"pieza":"camiseta","hex":"#2C3549","material":"algodón","removible":false,"detalle":"emblema dorado #B8903C centrado en el pecho"},{"orden":2,"pieza":"hoodie abierto","hex":"#9B9FA5","material":"felpa","removible":false},{"orden":3,"pieza":"cargo","hex":"#3D4459","material":"sarga","removible":false},{"orden":4,"pieza":"zapatillas","hex":"#3F4C66","material":"lona/goma","removible":false,"detalle":"suela y cordones #F0F0F0"},{"orden":5,"pieza":"mochila","hex":"#303338","material":"nylon","removible":true,"detalle":"solo si la escena la pide"}]},
