{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "myia://adn/v3",
  "title": "ADN MYIA v3 (personaje | objeto | escenario | estilo)",
  "type": "object",
  "required": ["id","version","clase","sha256_imagenes","identidad","ropa_o_material","anatomia_o_geometria","ubicacion_partes","variantes_vista","prohibidos","no_incluir_en_sello","frase_sello","checklist_validacion","sellado"],
  "properties": {
    "id": {"type":"string","pattern":"^(pj|obj|esc|est)_[a-z0-9_]+$"},
    "version": {"type":"string","pattern":"^v[0-9]+$"},
    "clase": {"enum":["personaje","objeto","escenario","estilo"]},
    "subclase_objeto": {"enum":["solido","accesorio","poder_energia","campo_fuerza","arma"],"description":"solo clase=objeto; poderes/energías SIEMPRE son objeto"},
    "sha256_imagenes": {"type":"array","minItems":1,"items":{"type":"object","required":["ruta","sha256","vista","origen"],"properties":{"ruta":{"type":"string"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"vista":{"enum":["frente","espalda","perfil_izq","perfil_der","tres_cuartos","closeup_cara","closeup_textura","closeup_accesorio","emocion","hoja_objeto","en_uso","entorno_angulo","estilo"]},"origen":{"enum":["hoja_neutra","recorte_resultado","render_final","molde_blender"]},"resolucion_px":{"type":"array","items":{"type":"integer"}}}}},
    "identidad": {"type":"object","required":["morfologia","hex","materiales"],"properties":{
      "morfologia":{"type":"string"},
      "hex":{"type":"object","additionalProperties":{"type":"string","pattern":"^#[0-9A-Fa-f]{6}$"}},
      "materiales":{"type":"array","items":{"type":"string"}},
      "rasgos_unicos":{"type":"array","items":{"type":"string"}}}},
    "ropa_o_material": {"type":"object","properties":{"capas":{"type":"array","items":{"type":"object","required":["orden","pieza","hex","material","removible"],"properties":{"orden":{"type":"integer","description":"1=piel/núcleo hacia afuera"},"pieza":{"type":"string"},"hex":{"type":"string"},"material":{"type":"string"},"removible":{"type":"boolean","description":"true = NO entra en frase_sello; se activa por escena"},"detalle":{"type":"string"}}}}}},
    "anatomia_o_geometria": {"type":"object","required":["altura_cm","proporciones"],"properties":{
      "altura_cm":{"type":"object","required":["valor","fuente"],"properties":{"valor":{"type":["number","null"]},"fuente":{"enum":["blender_bbox","ficha_ricardo","provisional"]}}},
      "peso_rel":{"type":"object","properties":{"valor":{"type":["number","null"]},"referencia":{"type":"string"},"fuente":{"enum":["derivado_blender","relativo","ficha_ricardo","provisional"]}}},
      "proporciones":{"type":"object","description":"ratios: cabezas_de_alto, hombros/cadera, largo_brazo/altura; objeto: largo/ancho/grosor"},
      "complexion":{"type":"string"}}},
    "ubicacion_partes": {"type":"array","minItems":3,"items":{"type":"object","required":["parte","donde","lado"],"properties":{"parte":{"type":"string"},"donde":{"type":"string","description":"frase con referencia anatómica/geométrica: 'muñeca, 2 cm sobre el carpo'"},"lado":{"enum":["IZQ","DER","centro","ambos","n/a"],"description":"lado DEL SUJETO, no de la cámara"},"visible_en":{"type":"array","items":{"type":"string"}},"forma":{"type":"string"}}}},
    "variantes_vista": {"type":"object","properties":{"frente":{"type":["string","null"]},"espalda":{"type":["string","null"]},"perfil":{"type":["string","null"]},"tres_cuartos":{"type":["string","null"]},"emociones":{"type":"array","items":{"type":"object","properties":{"nombre":{"type":"string"},"ruta":{"type":["string","null"]},"cambios_faciales":{"type":"string"}}}}},"description":"valor = ruta de hoja o null (GAP)"},
    "prohibidos": {"type":"array","items":{"type":"string"}},
    "no_incluir_en_sello": {"type":"array","items":{"type":"string"},"default":["pose","emocion_de_toma","camara","encuadre","fondo","iluminacion_de_toma","accion","fx_variables","porcentaje_cuadro","edad"]},
    "frase_sello": {"type":"string","maxLength":240},
    "checklist_validacion": {"type":"object","additionalProperties":{"enum":["OK","FAIL","GAP","N/A"]}},
    "sellado": {"type":"boolean"},
    "sello_meta": {"type":"object","properties":{"sha256_json":{"type":"string"},"fecha":{"type":"string"},"version_anterior":{"type":["string","null"]},"argon_raw":{"type":"array","items":{"type":"string"}}}}
  },
  "examples": [
    {"id":"pj_kael","version":"v3","clase":"personaje",
