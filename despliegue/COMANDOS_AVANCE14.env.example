# Plantilla para operaciones (copiar a COMANDOS.env y editar rutas en el VPS).
# Sin secretos ni rutas de cliente.

VPS_EXP=/opt/myia-motor-v9-experimental-avance14
M=${VPS_EXP}/avance14_camara_directa_sb_exp/motor
BLENDER=/opt/blender/blender-4.2.3/blender

# Entrada externa normalizada (producida por orquestador en otra ruta)
PAQUETE=${PAQUETE:-/ruta/externa/paquete_normalizado}
NUCLEO=${NUCLEO:-/ruta/externa/nucleo_reutilizable}

SAL=${VPS_EXP}/ejecuciones/run_manual
